import ExamAdministration from './ExamAdministration';
import SettingsManager from './SettingsManager';
import TeacherManager from './TeacherManager';
import ScoringManager from './ScoringManager';
import ScheduleManager from './ScheduleManager';
import QuestionEditor from './QuestionEditor';
import {useEffect,useMemo,useState,type ChangeEvent} from 'react';
import {supabase,configured} from './supabase';
import * as XLSX from 'xlsx';
import {LayoutDashboard,Users,DoorOpen,BookOpen,CalendarDays,Settings,Upload,Download,LogOut,ShieldCheck,Shuffle,Plus,Search,RefreshCw,AlertTriangle,CheckCircle2,GraduationCap,Menu,X,ArrowRight,FileSpreadsheet,LockKeyhole,Pencil,Trash2,ClipboardCheck} from 'lucide-react';

type Role='admin'|'guru'|'pengawas'|'siswa';
type Profile={id:string;full_name:string;role:Role};
type Student={id:string;nis:string;nisn:string|null;full_name:string;class_id:string;gender:string;birth_date:string|null;status:string;notes:string};
type Class={id:string;code:string;level:number};
type Room={id:string;name:string;location:string;capacity:number;sort_order:number};
type Period={id:string;title:string;academic_year:string;start_date:string;end_date:string;is_active:boolean};
type Assignment={id:string;student_id:string;period_id:string;room_id:string;seat_number:number};
type Subject={id:string;name:string};
type Bank={id:string;title:string;subject_id:string;class_id:string|null;owner_id:string};
type Tab='administrasi'|'ringkasan'|'siswa'|'guru'|'ruang'|'bank'|'jadwal'|'penilaian'|'pengaturan'|'akun';
type Candidate={nis:string;nisn:string|null;full_name:string;class_id:string;gender:string;birth_date:string|null;status:string;notes:string};
const expected={'X.1':14,'X.2':25,'XI.1':26,'XI.2':37,'XII.1':24,'XII.2':41};
const nav:[Tab,string,typeof LayoutDashboard][]=[['ringkasan','Dashboard',LayoutDashboard],['administrasi','Administrasi Ujian',FileSpreadsheet],['siswa','Data Siswa',Users],['guru','Manajemen Guru',Users],['ruang','Ruang & Penempatan',DoorOpen],['bank','Bank Soal',BookOpen],['penilaian','Penilaian & Nilai',ClipboardCheck],['jadwal','Jadwal Ujian',CalendarDays],['pengaturan','Pengaturan',Settings],['akun','Akun Saya',ShieldCheck]];
function err(e:unknown){return e instanceof Error?e.message:String(e)}
function noticeLabel(s:string){return s.length>160?s.slice(0,160)+'…':s}
export default function App(){
 const [session,setSession]=useState<any>(null),[profile,setProfile]=useState<Profile|null>(null),[authBusy,setAuthBusy]=useState(true),[email,setEmail]=useState(''),[password,setPassword]=useState(''),[loginBusy,setLoginBusy]=useState(false);
 const [tab,setTab]=useState<Tab>('ringkasan'),[menu,setMenu]=useState(false),[loading,setLoading]=useState(false),[toast,setToast]=useState('');
 const [students,setStudents]=useState<Student[]>([]),[classes,setClasses]=useState<Class[]>([]),[rooms,setRooms]=useState<Room[]>([]),[periods,setPeriods]=useState<Period[]>([]),[assignments,setAssignments]=useState<Assignment[]>([]),[subjects,setSubjects]=useState<Subject[]>([]),[banks,setBanks]=useState<Bank[]>([]);
 const [query,setQuery]=useState(''),[csvPreview,setCsvPreview]=useState<Candidate[]>([]),[fileErrors,setFileErrors]=useState<string[]>([]),[uploading,setUploading]=useState(false),[roomMode,setRoomMode]=useState<'acak'|'manual'>('acak'),[chosenStudent,setChosenStudent]=useState(''),[chosenRoom,setChosenRoom]=useState(''),[chosenSeat,setChosenSeat]=useState('1');
 const [newPassword,setNewPassword]=useState(''),[passwordBusy,setPasswordBusy]=useState(false);
 const [authMode,setAuthMode]=useState<'login'|'forgot'|'reset'>('login');
 const [resetPassword,setResetPassword]=useState(''),[resetConfirm,setResetConfirm]=useState(''),[resetBusy,setResetBusy]=useState(false);
 const [selectedBankId,setSelectedBankId]=useState<string|null>(null);
 const [newBankTitle,setNewBankTitle]=useState(''),[newBankSubject,setNewBankSubject]=useState(''),[newBankClass,setNewBankClass]=useState('');
 const [newRoomName,setNewRoomName]=useState(''),[newRoomPlace,setNewRoomPlace]=useState(''),[newRoomCap,setNewRoomCap]=useState('20');

 // CBTPlus v1.5 — Form tambah siswa manual
 const [studentNis,setStudentNis]=useState('');
 const [studentNisn,setStudentNisn]=useState('');
 const [studentName,setStudentName]=useState('');
 const [studentClass,setStudentClass]=useState('');
 const [studentGender,setStudentGender]=useState<'L'|'P'>('L');
 const [studentBirth,setStudentBirth]=useState('');
 const [studentStatus,setStudentStatus]=useState('Aktif');
 const [studentNotes,setStudentNotes]=useState('');
 const [manualBusy,setManualBusy]=useState(false);
 // Bank soal: ID item yang sedang diedit
 const [editingBank,setEditingBank]=useState<string|null>(null);

 const isAdmin=profile?.role==='admin';const canEdit=profile?.role==='admin'||profile?.role==='guru';
 const activePeriod=periods.find(p=>p.is_active)||periods[0];
 function flash(message:string){setToast(noticeLabel(message));}
 useEffect(()=>{if(!supabase){setAuthBusy(false);return}const client=supabase;client.auth.getSession().then(({data})=>{setSession(data.session);setAuthBusy(false)});const {data:{subscription}}=client.auth.onAuthStateChange((event,s)=>{setSession(s);if(event==='PASSWORD_RECOVERY')setAuthMode('reset');setAuthBusy(false)});return()=>subscription.unsubscribe()},[]);
 useEffect(()=>{if(!session?.user?.id||!supabase){setProfile(null);return}supabase.from('profiles').select('id,full_name,role').eq('id',session.user.id).single().then(({data,error})=>{if(error){flash('Profil belum dibuat. Jalankan langkah bootstrap admin pada README.');setProfile(null)}else setProfile(data as Profile)})},[session?.user?.id]);
 async function loadData(){if(!supabase||!canEdit)return;setLoading(true);try{const [cl,st,rm,pr,as,su,ba]=await Promise.all([supabase.from('classes').select('*').order('code'),supabase.from('students').select('*').order('full_name').limit(3000),supabase.from('exam_rooms').select('*').order('sort_order'),supabase.from('exam_periods').select('*').order('start_date',{ascending:false}),supabase.from('room_assignments').select('*').limit(3000),supabase.from('subjects').select('*').order('name'),supabase.from('question_banks').select('*').order('created_at',{ascending:false})]);for(const res of [cl,st,rm,pr,as,su,ba])if(res.error)throw res.error;setClasses(cl.data||[]);setStudents(st.data||[]);setRooms(rm.data||[]);setPeriods(pr.data||[]);setAssignments(as.data||[]);setSubjects(su.data||[]);setBanks(ba.data||[])}catch(e){flash('Gagal mengambil data: '+err(e))}finally{setLoading(false)}}
 useEffect(()=>{if(canEdit)void loadData()},[profile?.id,profile?.role]);
 async function login(e:React.FormEvent){e.preventDefault();if(!supabase)return;setLoginBusy(true);const {error}=await supabase.auth.signInWithPassword({email,password});if(error)flash('Login gagal: '+error.message);setLoginBusy(false)}
 async function requestPasswordReset(e:React.FormEvent){
  e.preventDefault();if(!supabase||!email.trim())return;
  setResetBusy(true);
  const redirectTo=new URL(import.meta.env.BASE_URL,window.location.origin).toString();
  const {error}=await supabase.auth.resetPasswordForEmail(email.trim(),{redirectTo});
  if(error)flash('Gagal mengirim email pemulihan: '+error.message);
  else flash('Jika email terdaftar, tautan pemulihan akan dikirim. Periksa inbox dan spam.');
  setResetBusy(false);
 }
 async function saveRecoveredPassword(e:React.FormEvent){
  e.preventDefault();if(!supabase)return;
  if(resetPassword.length<10){flash('Password minimal 10 karakter.');return}
  if(resetPassword!==resetConfirm){flash('Konfirmasi password tidak sama.');return}
  setResetBusy(true);
  const {error}=await supabase.auth.updateUser({password:resetPassword});
  if(error){flash('Gagal menyimpan password: '+error.message);setResetBusy(false);return}
  await supabase.auth.signOut();setProfile(null);setAuthMode('login');setResetPassword('');setResetConfirm('');setPassword('');
  flash('Password baru berhasil disimpan. Silakan masuk kembali.');setResetBusy(false);
 }
 async function logout(){await supabase?.auth.signOut();setProfile(null);setTab('ringkasan')}
 const classesById=useMemo(()=>Object.fromEntries(classes.map(c=>[c.id,c.code])),[classes]);
 const studentsById=useMemo(()=>Object.fromEntries(students.map(s=>[s.id,s])),[students]);
 const assignmentMap=useMemo(()=>new Map(assignments.filter(a=>a.period_id===activePeriod?.id).map(a=>[a.student_id,a])),[assignments,activePeriod?.id]);
 const filtered=students.filter(s=>[s.nis,s.full_name,classesById[s.class_id]].join(' ').toLowerCase().includes(query.toLowerCase()));
 const cards=[{label:'Total Peserta',value:students.length,icon:Users},{label:'Rombel',value:classes.length,icon:GraduationCap},{label:'Ruang Ujian',value:rooms.length,icon:DoorOpen},{label:'Penempatan',value:assignments.filter(a=>a.period_id===activePeriod?.id).length,icon:ShieldCheck}];
 async function fileChanged(e:ChangeEvent<HTMLInputElement>){setCsvPreview([]);setFileErrors([]);const file=e.target.files?.[0];e.target.value='';if(!file)return;try{const workbook=XLSX.read(await file.arrayBuffer(),{type:'array',cellDates:true});const sheet=workbook.Sheets['IMPORT_SISWA']||workbook.Sheets[workbook.SheetNames[0]];const data=XLSX.utils.sheet_to_json<Record<string,unknown>>(sheet,{defval:'',raw:false});const errors:string[]=[];const list:Candidate[]=[];const seen=new Set<string>();const allNis=new Set(students.map(s=>s.nis));data.forEach((raw,i)=>{const at=`Baris ${i+2}`;const val=(k:string)=>String(raw[k]??'').trim();const nis=val('nis'),full_name=val('nama_lengkap'),classCode=val('kelas'),gender=val('jenis_kelamin').toUpperCase(),status=val('status_peserta')||'Aktif',date=val('tanggal_lahir');if(!nis&&!full_name)return;if(full_name.toUpperCase().startsWith('CONTOH')){errors.push(`${at}: Hapus data CONTOH sebelum impor.`);return}const cls=classes.find(c=>c.code===classCode);if(!nis||!full_name||!cls){errors.push(`${at}: NIS/nama/kelas tidak valid.`);return}if(gender!=='L'&&gender!=='P'){errors.push(`${at}: Jenis kelamin wajib L atau P.`);return}if(!['Aktif','Nonaktif'].includes(status)){errors.push(`${at}: Status harus Aktif atau Nonaktif.`);return}if(seen.has(nis)||allNis.has(nis)){errors.push(`${at}: NIS ${nis} sudah ada/duplikat.`);return}const parsedDate=date?(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/.test(date)?date:null):null;if(date&&!parsedDate){errors.push(`${at}: tanggal_lahir harus YYYY-MM-DD.`);return}seen.add(nis);list.push({nis,nisn:val('nisn')||null,full_name,class_id:cls.id,gender,birth_date:parsedDate,status,notes:val('catatan')})});setCsvPreview(list);setFileErrors(errors);if(!data.length)flash('File Excel kosong.') }catch(e){flash('File tidak dapat dibaca: '+err(e))}}
 async function importStudents(){if(!supabase||!isAdmin||fileErrors.length||!csvPreview.length)return;setUploading(true);try{for(let i=0;i<csvPreview.length;i+=100){const {error}=await supabase.from('students').insert(csvPreview.slice(i,i+100));if(error)throw error}flash(`${csvPreview.length} siswa berhasil diimpor.`);setCsvPreview([]);await loadData()}catch(e){flash('Impor berhenti. Sebagian batch mungkin sudah tersimpan; muat ulang sebelum mencoba lagi: '+err(e))}finally{setUploading(false)}}
 async function addStudentManually(e:React.FormEvent){e.preventDefault();if(!supabase||!isAdmin||manualBusy)return;
 const nis=studentNis.trim(),full_name=studentName.trim(),nisn=studentNisn.trim();
 if(!nis||!full_name||!studentClass){flash('Isi NIS, nama, dan kelas siswa');return}
 if(students.some(x=>x.nis===nis)){flash('NIS telah terdaftar');return}
 setManualBusy(true);
 const {error}=await supabase.from('students').insert({nis,nisn:nisn||null,full_name,class_id:studentClass,gender:studentGender,birth_date:studentBirth||null,status:studentStatus,notes:studentNotes.trim()});
 setManualBusy(false);
 if(error){flash('Gagal tambah siswa: '+error.message);return}
 flash('Siswa berhasil ditambahkan secara manual.');setStudentNis('');setStudentNisn('');setStudentName('');setStudentBirth('');setStudentNotes('');await loadData();
 }
 async function updateBank(e:React.FormEvent){e.preventDefault();if(!supabase||!editingBank||!newBankTitle.trim()||!newBankSubject)return;
 const b=banks.find(x=>x.id===editingBank);if(!b||!(isAdmin||b.owner_id===profile?.id)){flash('Tidak diizinkan mengubah bank soal');return}
 const {error}=await supabase.from('question_banks').update({title:newBankTitle.trim(),subject_id:newBankSubject,class_id:newBankClass||null}).eq('id',editingBank);
 if(error)flash('Gagal edit bank: '+error.message);else{setEditingBank(null);setNewBankTitle('');setNewBankSubject('');setNewBankClass('');flash('Bank soal berhasil diperbarui');await loadData()}
 }
 function startEditBank(bank:Bank){setEditingBank(bank.id);setNewBankTitle(bank.title);setNewBankSubject(bank.subject_id);setNewBankClass(bank.class_id||'')}
 async function removeBank(bank:Bank){if(!supabase||!(isAdmin||bank.owner_id===profile?.id))return;
 if(!window.confirm(`Hapus bank soal “${bank.title}” beserta seluruh soalnya? Tindakan ini tidak dapat dibatalkan. Bank yang dipakai jadwal akan ditolak.`))return;
 const {error}=await supabase.from('question_banks').delete().eq('id',bank.id);
 if(error)flash('Tidak dapat menghapus bank: '+error.message);else{if(selectedBankId===bank.id)setSelectedBankId(null);if(editingBank===bank.id)setEditingBank(null);flash('Bank soal dihapus');await loadData()}
 }
 async function assignManually(){if(!supabase||!activePeriod||!isAdmin||!chosenStudent||!chosenRoom)return;const seat=Number(chosenSeat);if(!Number.isInteger(seat)||seat<1){flash('Nomor kursi harus bilangan positif');return}const {error}=await supabase.rpc('assign_student_room',{p_period:activePeriod.id,p_student:chosenStudent,p_room:chosenRoom,p_seat:seat});if(error)flash('Gagal memindah: '+error.message);else{flash('Penempatan berhasil disimpan untuk seluruh periode.');await loadData()}}
 async function generate(){if(!supabase||!activePeriod||!isAdmin)return;if(assignments.some(a=>a.period_id===activePeriod.id)){flash('Sudah ada penempatan periode ini. Gunakan menu manual untuk mengubahnya.');return}if(!window.confirm(`Bagi ${students.filter(s=>s.status==='Aktif').length} siswa aktif secara acak merata? Penempatan akan tetap sepanjang periode ${activePeriod.title}.`))return;setLoading(true);const {data,error}=await supabase.rpc('generate_balanced_rooms',{p_period:activePeriod.id});if(error)flash('Gagal mengacak: '+error.message);else{flash(`Berhasil menempatkan ${data} siswa.`);await loadData()}setLoading(false)}
 async function createBank(e:React.FormEvent){e.preventDefault();if(!supabase||!profile||!newBankSubject||!newBankTitle.trim())return;const {error}=await supabase.from('question_banks').insert({title:newBankTitle.trim(),subject_id:newBankSubject,class_id:newBankClass||null,owner_id:profile.id});if(error)flash(error.message);else{flash('Bank soal dibuat. Klik judul bank untuk membuka editor soal.');setNewBankTitle('');await loadData()}}
 async function changePassword(e:React.FormEvent){e.preventDefault();if(!supabase||newPassword.length<10){flash('Password minimal 10 karakter.');return}setPasswordBusy(true);const {error}=await supabase.auth.updateUser({password:newPassword});if(error)flash('Gagal mengubah password: '+error.message);else{flash('Password berhasil diubah. Gunakan password baru saat login selanjutnya.');setNewPassword('')}setPasswordBusy(false)}
 async function createRoom(e:React.FormEvent){e.preventDefault();if(!supabase||!isAdmin)return;const capacity=Number(newRoomCap);if(!newRoomName.trim()||!newRoomPlace.trim()||!Number.isInteger(capacity)||capacity<1){flash('Isi nama, lokasi, dan kapasitas valid');return}const {error}=await supabase.from('exam_rooms').insert({name:newRoomName.trim(),location:newRoomPlace.trim(),capacity,sort_order:rooms.length+1});if(error)flash(error.message);else{flash('Ruang ditambahkan');setNewRoomName('');setNewRoomPlace('');await loadData()}}
 if(!configured)return <div className="centerpage"><div className="authbox"><div className="brandmark"><GraduationCap/></div><h1>CBT<span>Plus</span></h1><p>Konfigurasi belum tersedia.</p><div className="alert">Salin <code>.env.example</code> menjadi <code>.env</code>, lalu isi URL dan publishable key proyek Supabase Anda.</div><small>Ikuti README.md untuk menjalankan aplikasi.</small></div></div>;
 if(authBusy)return <div className="centerpage">Memeriksa sesi CBTPlus…</div>;
 if(authMode==='reset')return <div className="centerpage"><form className="authbox" onSubmit={saveRecoveredPassword}><div className="brandmark"><LockKeyhole/></div><h1>CBT<span>Plus</span></h1><h2>Buat Password Baru</h2><p>Gunakan minimal 10 karakter untuk keamanan akun.</p><label>Password baru<input type="password" autoComplete="new-password" minLength={10} required value={resetPassword} onChange={e=>setResetPassword(e.target.value)}/></label><label>Konfirmasi password<input type="password" autoComplete="new-password" minLength={10} required value={resetConfirm} onChange={e=>setResetConfirm(e.target.value)}/></label><button type="submit" className="primary wide" disabled={resetBusy||!session}>{resetBusy?'Menyimpan…':'Simpan Password Baru'}</button>{!session&&<div className="alert">Tautan tidak valid atau sudah kedaluwarsa. Silakan minta tautan pemulihan baru.</div>}{toast&&<div className="alert">{toast}</div>}</form></div>;
 if(!session&&authMode==='forgot')return <div className="centerpage"><form className="authbox" onSubmit={requestPasswordReset}><div className="brandmark"><LockKeyhole/></div><h1>CBT<span>Plus</span></h1><h2>Lupa Password?</h2><p>Masukkan email akun guru atau admin untuk menerima tautan pemulihan.</p><label>Email pengguna<input type="email" autoComplete="email" required value={email} onChange={e=>setEmail(e.target.value)} placeholder="email@sekolah.sch.id"/></label><button type="submit" className="primary wide" disabled={resetBusy}>{resetBusy?'Mengirim…':'Kirim Link Reset Password'}</button><button type="button" className="outlinebutton" onClick={()=>{setAuthMode('login');setToast('')}}>Kembali ke Login</button>{toast&&<div className="alert">{toast}</div>}</form></div>;
 if(!session)return <div className="centerpage"><form className="authbox" onSubmit={login}><div className="brandmark"><GraduationCap/></div><h1>CBT<span>Plus</span></h1><p>Dashboard Admin & Guru<br/>MA Plus Sunan Giri Salatiga</p><label>Email pengguna<input type="email" autoComplete="username" required value={email} onChange={e=>setEmail(e.target.value)} placeholder="admin@sekolah.sch.id"/></label><label>Kata sandi<input type="password" required autoComplete="current-password" value={password} onChange={e=>setPassword(e.target.value)} placeholder="••••••••"/></label><button type="button" className="outlinebutton" onClick={()=>{setAuthMode('forgot');setToast('')}}>Lupa Password?</button><button disabled={loginBusy} className="primary wide" type="submit">{loginBusy?'Memproses…':'Masuk Dashboard'} <ArrowRight size={17}/></button><small>Gunakan akun yang dibuat oleh admin CBTPlus.</small>{toast&&<div className="alert">{toast}</div>}</form></div>;
 if(!profile)return <div className="centerpage"><div className="authbox"><ShieldCheck size={28}/><h2>Profil belum tersedia</h2><p>Akun terautentikasi, tetapi belum diberi peran. Ikuti langkah bootstrap pada README.</p><button onClick={logout}>Keluar</button>{toast&&<div className="alert">{toast}</div>}</div></div>;
 if(!canEdit)return <div className="centerpage"><div className="authbox"><ShieldCheck size={32}/><h2>Dashboard khusus admin dan guru</h2><p>Peran Anda: <b>{profile.role}</b>. Pengawas dan siswa menggunakan aplikasi khusus.</p><button onClick={logout}>Keluar</button></div></div>;
 return <div className="app-shell"><aside className={`sidebar ${menu?'open':''}`}><div className="brand"><div className="brandmark"><GraduationCap/></div><div><b>CBT<span>Plus</span></b><small>MA Plus Sunan Giri</small></div><button className="iconbutton closemenu" onClick={()=>setMenu(false)}><X/></button></div><div className="sidebar-section">MENU UTAMA</div><nav>{nav.filter(([id])=>isAdmin||!['siswa','guru','ruang','pengaturan','administrasi'].includes(id)).map(([id,label,Icon])=><button className={`navlink ${tab===id?'active':''}`} key={id} onClick={()=>{setTab(id);setMenu(false);setQuery('')}}><Icon size={19}/>{label}</button>)}</nav><div className="sidebar-footer"><div className="userchip"><div className="avatar">{profile.full_name?.[0]?.toUpperCase()||'U'}</div><div><strong>{profile.full_name||'Pengguna'}</strong><small>{profile.role.toUpperCase()}</small></div></div><button className="logout" onClick={logout}><LogOut size={18}/> Keluar</button></div></aside>{menu&&<div className="scrim" onClick={()=>setMenu(false)}/>}
 <main className="content"><header className="topbar"><button className="iconbutton hamburger" onClick={()=>setMenu(true)}><Menu/></button><div><small>MA PLUS SUNAN GIRI SALATIGA</small><h2>{nav.find(n=>n[0]===tab)?.[1]}</h2></div><div className="topactions"><span className="period-pill"><span className="dot"/>{activePeriod?`${activePeriod.title} ${activePeriod.academic_year}`:'Belum ada periode'}</span><button title="Muat ulang data" className="iconbutton" disabled={loading} onClick={loadData}><RefreshCw size={18}/></button></div></header>
 {toast&&<div className="toast" role="status"><span>{toast}</span><button className="iconbutton" onClick={()=>setToast('')}><X size={16}/></button></div>}
 {tab==='ringkasan'&&<><section className="hero"><div><div className="eyebrow">SISTEM ASESMEN TERINTEGRASI</div><h1>Selamat datang di CBTPlus</h1><p>Kelola asesmen, peserta, penempatan ruang, dan bank soal melalui satu dashboard.</p><button className="lightbutton" onClick={()=>setTab('siswa')}>Kelola data siswa <ArrowRight size={16}/></button></div><div className="heroicon"><GraduationCap size={100} strokeWidth={1.1}/></div></section><div className="statgrid">{cards.map(({label,value,icon:Icon})=><div className="statcard" key={label}><div className="statheading">{label}<span><Icon size={19}/></span></div><strong>{value}</strong><small>Data yang sudah tersimpan</small></div>)}</div><div className="twocol"><section className="panel"><div className="panelhead"><div><h3>Peserta per kelas</h3><p>Jumlah siswa sesuai data impor</p></div></div>{classes.map(c=><div className="classline" key={c.id}><span>Kelas {c.code}</span><div className="progress"><div style={{width:`${Math.min(100,students.filter(s=>s.class_id===c.id).length/Math.max(1,expected[c.code as keyof typeof expected]||1)*100)}%`}}/></div><b>{students.filter(s=>s.class_id===c.id).length}</b><small>/{expected[c.code as keyof typeof expected]||'-'}</small></div>)}</section><section className="panel"><div className="panelhead"><div><h3>Kesiapan sistem</h3><p>Fondasi berdasarkan juknis ASAS Gasal 2026/2027</p></div></div><div className="statusrow"><CheckCircle2/> Kelas dan ruang awal terkonfigurasi</div><div className="statusrow"><CheckCircle2/> Format impor siswa Excel tersedia</div><div className="statusrow"><CheckCircle2/> Penempatan per periode tersedia</div><div className="statusrow muted"><AlertTriangle/> Editor soal dan aplikasi ujian: tahap lanjutan</div><div className="infobox">Ruang dan kursi tidak diacak ulang setiap hari. Pengacakan berlaku sekali untuk periode ujian.</div></section></div></>}
 {tab==='siswa'&&<><div className="pageintro"><div><h2>Manajemen Siswa</h2><p>Impor data menggunakan Excel; tidak perlu menginput satu per satu.</p></div><a className="outlinebutton" href={`${import.meta.env.BASE_URL}template-import-siswa.xlsx`} download><Download size={17}/> Download Template Excel</a></div><section className="panel"><h3>Tambah Siswa Manual</h3><p>Untuk siswa baru atau koreksi data satu per satu. Import Excel tetap tersedia.</p><form className="formgrid" onSubmit={addStudentManually}>
 <label>NIS *<input required value={studentNis} onChange={e=>setStudentNis(e.target.value)}/></label>
 <label>NISN (opsional)<input value={studentNisn} onChange={e=>setStudentNisn(e.target.value)}/></label>
 <label>Nama lengkap *<input required value={studentName} onChange={e=>setStudentName(e.target.value)}/></label>
 <label>Kelas *<select required value={studentClass} onChange={e=>setStudentClass(e.target.value)}><option value="">Pilih kelas</option>{classes.map(c=><option key={c.id} value={c.id}>{c.code}</option>)}</select></label>
 <label>Jenis kelamin<select value={studentGender} onChange={e=>setStudentGender(e.target.value as 'L'|'P')}><option value="L">Laki-laki</option><option value="P">Perempuan</option></select></label>
 <label>Tanggal lahir<input type="date" value={studentBirth} onChange={e=>setStudentBirth(e.target.value)}/></label>
 <label>Status<select value={studentStatus} onChange={e=>setStudentStatus(e.target.value)}><option>Aktif</option><option>Nonaktif</option></select></label>
 <label>Catatan<input value={studentNotes} onChange={e=>setStudentNotes(e.target.value)}/></label>
 <button className="primary" type="submit" disabled={!isAdmin||manualBusy}><Plus size={16}/>{manualBusy?'Menyimpan…':'Tambah Siswa'}</button></form></section><section className="panel"><div className="sectiontitle"><FileSpreadsheet/><div><h3>Import Data Siswa</h3><p>Kolom: nis, nisn, nama_lengkap, kelas, jenis_kelamin, tanggal_lahir, status_peserta, catatan</p></div></div><div className="importrow"><label className="uploadbutton"><Upload size={18}/> Pilih file .xlsx / .xls <input type="file" accept=".xlsx,.xls" onChange={fileChanged} disabled={!isAdmin}/></label><small>Hanya admin yang dapat mengimpor siswa. Hapus baris CONTOH terlebih dahulu.</small></div>{fileErrors.length>0&&<div className="errorbox"><b>{fileErrors.length} kesalahan validasi</b><ul>{fileErrors.slice(0,12).map((x,i)=><li key={i}>{x}</li>)}{fileErrors.length>12&&<li>… dan {fileErrors.length-12} lainnya</li>}</ul></div>}{csvPreview.length>0&&<div className="preview"><b>Pratinjau: {csvPreview.length} siswa valid</b><div className="scrolltable"><table><thead><tr><th>NIS</th><th>Nama</th><th>Kelas</th><th>JK</th></tr></thead><tbody>{csvPreview.slice(0,8).map(s=><tr key={s.nis}><td>{s.nis}</td><td>{s.full_name}</td><td>{classesById[s.class_id]}</td><td>{s.gender}</td></tr>)}</tbody></table></div><button className="primary" disabled={!isAdmin||uploading||!!fileErrors.length} onClick={importStudents}>{uploading?'Mengimpor…':`Validasi & Simpan ${csvPreview.length} Siswa`}</button></div>}</section><section className="panel"><div className="panelhead"><div><h3>Daftar Siswa <span className="subcount">{students.length}</span></h3><p>Hasil impor tersimpan di database Supabase</p></div><div className="searchbox"><Search size={17}/><input value={query} onChange={e=>setQuery(e.target.value)} placeholder="Cari nama, NIS, kelas"/></div></div><div className="scrolltable"><table><thead><tr><th>NIS</th><th>Nama lengkap</th><th>Kelas</th><th>JK</th><th>Status</th><th>Ruang</th></tr></thead><tbody>{filtered.map(s=><tr key={s.id}><td className="mono">{s.nis}</td><td><b>{s.full_name}</b></td><td>{classesById[s.class_id]||'-'}</td><td>{s.gender}</td><td><span className={`tag ${s.status==='Aktif'?'green':''}`}>{s.status}</span></td><td>{rooms.find(r=>r.id===assignmentMap.get(s.id)?.room_id)?.name||'Belum ditempatkan'}</td></tr>)}{!filtered.length&&<tr><td colSpan={6} className="empty">Belum ada siswa. Unduh template, isi data, lalu impor ke Supabase.</td></tr>}</tbody></table></div></section></>}
 {tab==='ruang'&&<><div className="pageintro"><div><h2>Ruang Ujian</h2><p>Penempatan satu kali per periode, tetap sepanjang jadwal ujian.</p></div><span className="pill"><LockKeyhole size={15}/> {activePeriod?.title||'Belum ada periode'}</span></div><div className="roomgrid">{rooms.map(r=>{const x=assignments.filter(a=>a.period_id===activePeriod?.id&&a.room_id===r.id);return <div className="roomcard" key={r.id}><div className="roomtop"><DoorOpen/><b>{r.name}</b></div><p>{r.location}</p><strong>{x.length} <span>/ {r.capacity} kursi</span></strong><div className="progress"><div style={{width:`${Math.min(100,x.length/r.capacity*100)}%`}}/></div><small>{x.length?Array.from(new Set(x.map(a=>classesById[studentsById[a.student_id]?.class_id]).filter(Boolean))).join(' • '):'Belum ada penempatan'}</small></div>})}</div><section className="panel"><div className="panelhead"><div><h3>Penempatan Peserta</h3><p>Dua metode: acak merata atau manual admin</p></div></div><div className="segmented"><button className={roomMode==='acak'?'selected':''} onClick={()=>setRoomMode('acak')}><Shuffle size={16}/> Acak Merata</button><button className={roomMode==='manual'?'selected':''} onClick={()=>setRoomMode('manual')}><Users size={16}/> Manual Admin</button></div>{roomMode==='acak'?<div className="methodbody"><h4>Acak merata berdasarkan kelas</h4><p>Peserta kelas X, XI, dan XII dibagikan secara acak dengan pemerataan asal kelas dan kapasitas ruang. Hasil penempatan digunakan untuk seluruh mata pelajaran dalam periode ini.</p><div className="infobox">Pengacakan hanya bisa dilakukan jika periode ini belum memiliki penempatan. Setelah generate, perubahan dilakukan secara manual.</div><button className="primary" disabled={!isAdmin||loading||!students.length||assignments.some(a=>a.period_id===activePeriod?.id)} onClick={generate}><Shuffle size={17}/> Generate Sekali untuk Periode Ini</button></div>:<div className="methodbody"><h4>Penempatan atau perubahan individual</h4><p>Admin dapat menempatkan siswa atau mengubah ruang dan kursinya tanpa mengubah peserta lain.</p><div className="formgrid"><label>Pilih siswa<select value={chosenStudent} onChange={e=>{setChosenStudent(e.target.value);const old=assignmentMap.get(e.target.value);if(old){setChosenRoom(old.room_id);setChosenSeat(String(old.seat_number))}}}><option value="">-- Pilih siswa --</option>{students.map(s=><option key={s.id} value={s.id}>{s.nis} — {s.full_name} ({classesById[s.class_id]})</option>)}</select></label><label>Ruang<select value={chosenRoom} onChange={e=>setChosenRoom(e.target.value)}><option value="">-- Pilih ruang --</option>{rooms.map(r=><option key={r.id} value={r.id}>{r.name} ({r.location})</option>)}</select></label><label>Nomor kursi<input type="number" min={1} value={chosenSeat} onChange={e=>setChosenSeat(e.target.value)}/></label></div><button className="primary" disabled={!isAdmin} onClick={assignManually}>Simpan Penempatan</button></div>}</section><section className="panel"><h3>Daftar Penempatan</h3><div className="scrolltable"><table><thead><tr><th>NIS</th><th>Peserta</th><th>Kelas asal</th><th>Ruang</th><th>Kursi</th></tr></thead><tbody>{assignments.filter(a=>a.period_id===activePeriod?.id).sort((a,b)=>((rooms.find(r=>r.id===a.room_id)?.sort_order||0)-(rooms.find(r=>r.id===b.room_id)?.sort_order||0))||a.seat_number-b.seat_number).map(a=><tr key={a.id}><td>{studentsById[a.student_id]?.nis}</td><td>{studentsById[a.student_id]?.full_name}</td><td>{classesById[studentsById[a.student_id]?.class_id]}</td><td>{rooms.find(r=>r.id===a.room_id)?.name}</td><td>{a.seat_number}</td></tr>)}{!assignments.some(a=>a.period_id===activePeriod?.id)&&<tr><td className="empty" colSpan={5}>Belum ada penempatan ruang untuk periode ini.</td></tr>}</tbody></table></div></section><section className="panel"><h3>Tambah ruang baru</h3><form className="formgrid" onSubmit={createRoom}><label>Nama<input placeholder="Ruang 09" value={newRoomName} onChange={e=>setNewRoomName(e.target.value)} required/></label><label>Lokasi<input placeholder="Kelas / Gedung" value={newRoomPlace} onChange={e=>setNewRoomPlace(e.target.value)} required/></label><label>Kapasitas<input type="number" min="1" value={newRoomCap} onChange={e=>setNewRoomCap(e.target.value)} required/></label><button className="primary" type="submit" disabled={!isAdmin}><Plus size={17}/> Tambah Ruang</button></form></section></>}
 {tab==='bank'&&selectedBankId&&banks.find(b=>b.id===selectedBankId)?<QuestionEditor bank={banks.find(b=>b.id===selectedBankId)!} editable={!!(isAdmin||banks.find(b=>b.id===selectedBankId)?.owner_id===profile?.id)} onBack={()=>setSelectedBankId(null)} onNotice={flash}/>:null}
 {tab==='bank'&&!selectedBankId&&<><div className="pageintro"><div><h2>Bank Soal</h2><p>Fondasi bank soal PG, MCMA, kategori, dan esai sesuai juknis.</p></div></div><section className="panel"><h3>{editingBank?'Edit Bank Soal':'Buat Bank Soal'}</h3><form className="formgrid" onSubmit={editingBank?updateBank:createBank}><label>Nama bank soal<input value={newBankTitle} onChange={e=>setNewBankTitle(e.target.value)} placeholder="ASAS Matematika Kelas X" required/></label><label>Mata pelajaran<select value={newBankSubject} onChange={e=>setNewBankSubject(e.target.value)} required><option value="">-- Pilih mapel --</option>{subjects.map(s=><option key={s.id} value={s.id}>{s.name}</option>)}</select></label><label>Kelas<select value={newBankClass} onChange={e=>setNewBankClass(e.target.value)}><option value="">Semua / belum ditentukan</option>{classes.map(c=><option key={c.id} value={c.id}>{c.code}</option>)}</select></label><button type="submit" className="primary"><Plus size={17}/>{editingBank?'Simpan Perubahan':'Buat Bank'}</button>{editingBank&&<button className="outlinebutton" type="button" onClick={()=>{setEditingBank(null);setNewBankTitle('');setNewBankSubject('');setNewBankClass('')}}>Batal Edit</button>}</form></section><section className="panel"><h3>Daftar bank soal</h3><div className="scrolltable"><table><thead><tr><th>Judul</th><th>Mata pelajaran</th><th>Kelas</th><th>Aksi</th></tr></thead><tbody>{banks.map(b=><tr key={b.id}><td><button type="button" className="bank-open" onClick={()=>setSelectedBankId(b.id)}><BookOpen size={15}/>{b.title}</button></td><td>{subjects.find(s=>s.id===b.subject_id)?.name}</td><td>{classesById[b.class_id||'']||'Semua'}</td><td><div className="schedule-actions"><button type="button" className="outlinebutton" disabled={!(isAdmin||b.owner_id===profile?.id)} onClick={()=>startEditBank(b)}><Pencil size={14}/> Edit</button><button type="button" className="outlinebutton" disabled={!(isAdmin||b.owner_id===profile?.id)} onClick={()=>void removeBank(b)}><Trash2 size={14}/> Hapus</button></div></td></tr>)}{!banks.length&&<tr><td className="empty" colSpan={4}>Belum ada bank soal.</td></tr>}</tbody></table></div><div className="infobox">Klik nama bank soal untuk membuka editor PG, MCMA, kategori, dan esai. Kunci jawaban tersimpan secara terpisah.</div></section></>}
 {tab==='administrasi'&&<ExamAdministration period={activePeriod} students={students} classes={classes} rooms={rooms} assignments={assignments} subjects={subjects} banks={banks} onNotice={flash}/>}
 {tab==='penilaian'&&<ScoringManager period={activePeriod} subjects={subjects} classes={classes} banks={banks} isAdmin={isAdmin} userId={profile?.id||''} onNotice={flash}/>}
  {tab==='jadwal'&&<ScheduleManager period={activePeriod} classes={classes} subjects={subjects} banks={banks} isAdmin={isAdmin} onNotice={flash} onRefresh={loadData}/>}
 {tab==='akun'&&<><div className="pageintro"><div><h2>Akun Saya</h2><p>Set password setelah menerima undangan guru atau ganti password akun.</p></div></div><section className="panel"><h3>Ubah Password</h3><form className="formgrid" onSubmit={changePassword}><label>Password baru (minimal 10 karakter)<input type="password" minLength={10} required autoComplete="new-password" value={newPassword} onChange={e=>setNewPassword(e.target.value)}/></label><button className="primary" type="submit" disabled={passwordBusy}>Simpan Password</button></form><div className="infobox">Untuk guru baru: buka undangan email terlebih dahulu agar sesi login aktif, kemudian atur password di halaman ini.</div></section></>}
 {tab==='guru'&&isAdmin&&<TeacherManager onNotice={flash}/>}
 {tab==='pengaturan'&&isAdmin&&<SettingsManager periods={periods} isAdmin={isAdmin} onReload={loadData} onNotice={flash}/>}
 <footer>© 2026 CBTPlus · MA Plus Sunan Giri Salatiga <span>Dashboard v1.5 — administrasi & CRUD</span></footer></main></div>
}
